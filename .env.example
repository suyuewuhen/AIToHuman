# 数据库与基础依赖
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=change-me
ConnectionStrings__Redis=localhost:6379

# 运营可配置项的部署级默认值。运行时的解析顺序是「数据库覆盖 → 这里的值 → 代码默认值」，
# 也就是说这些变量是兜底，不是唯一入口：日常调整在运营后台改即可。
VolcengineAI__BaseUrl=https://ark.cn-beijing.volces.com/api/v3
VolcengineAI__ApiKey=
VolcengineAI__Model=glm-4-7-251222
VolcengineAI__TimeoutSeconds=120

# 凭证存储：local 写本机目录，s3 需要补上对应的 IFileStorage 实现
Settings__storage__provider=local
ObjectStorage__LocalRoot=
Settings__storage__s3__endpoint=
Settings__storage__s3__region=
Settings__storage__s3__bucket=
Settings__storage__s3__accessKeyId=
Settings__storage__s3__secretAccessKey=
Settings__storage__s3__prefix=evidence

# 凭证内容扫描：none 表示未接入（显式放行并打警告），http 调用下面配置的扫描服务
Settings__evidence__scanner__provider=none
Settings__evidence__scanner__endpoint=
Settings__evidence__scanner__apiKey=
Settings__evidence__scanner__timeoutSeconds=15
Settings__evidence__scanner__failMode=closed

# 凭证上传上限：硬上限是 25 MB / 50 份，运营只能往里收紧
Settings__evidence__maxSizeBytes=5242880
Settings__evidence__maxPerOrder=10

# 运营后台管理员：用户 ID 或邮箱，逗号分隔。留空时运营接口对所有人返回 403。
Admin__UserIds=
Admin__Emails=

# Data Protection 密钥环：用于加密机密配置。生产必须放到持久卷并让所有实例共享，否则重启或换实例后解不开已保存的密钥。
DataProtection__KeysPath=
